# Copy to .env and fill in. Never commit .env.

# LLM used for answer generation, OCR of scanned pages, gap analysis and eval judging.
# Without a key the assistant runs in retrieval-only mode (returns cited source passages, no generated answer).
COPILOT_LLM_PROVIDER=gemini
COPILOT_GEMINI_API_KEY=
COPILOT_GEMINI_MODEL=gemini-3.5-flash
# Optional: separate model (own quota) for gap analysis / eval judging
COPILOT_GEMINI_BATCH_MODEL=
# Alternative provider: COPILOT_LLM_PROVIDER=anthropic + COPILOT_ANTHROPIC_API_KEY=

# Postgres + pgvector (docker compose up -d db)
COPILOT_DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/copilot

# Secret for signing session tokens - set a long random value outside local dev.
COPILOT_JWT_SECRET=dev-only-change-me

# Retrieval models run locally; set to cuda if you have a GPU with the CUDA build of torch.
COPILOT_DEVICE=auto


# Chat history retention in days (set by DPO/legal); 0 disables saving history.
COPILOT_CHAT_RETENTION_DAYS=90
